<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Checkstyle configuration for photograph-platform.
    Based on Google Java Style Guide with practical relaxations.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- File-level suppressions (e.g. HTML email templates that contain
         long content lines, not long *code* lines). -->
    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/checkstyle-suppressions.xml"/>
        <property name="optional" value="true"/>
    </module>

    <!-- No tab characters -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- No trailing whitespace -->
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="minimum" value="0"/>
        <property name="maximum" value="0"/>
        <property name="message" value="Line has trailing spaces."/>
    </module>

    <!-- Line length — must be under Checker, not TreeWalker -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <!-- Ignore: package/import lines, URLs, and HTML markup inside text
             blocks (lines whose first non-whitespace char is '<' or '"' for
             the text-block delimiter). Java source never legitimately starts
             a line with '<', so this can't mask a real long line of code. -->
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://|^\s*&lt;|^\s*&quot;&quot;&quot;"/>
    </module>

    <module name="TreeWalker">

        <!-- Naming conventions -->
        <module name="TypeName"/>
        <module name="ConstantName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="MethodName"/>
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="ParameterName"/>
        <module name="StaticVariableName"/>

        <!-- Imports -->
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="IllegalImport"/>

        <!-- Braces -->
        <module name="NeedBraces"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>

        <!-- Whitespace -->
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyLambdas" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLoops" value="true"/>
        </module>
        <module name="WhitespaceAfter"/>
        <module name="NoWhitespaceBefore"/>
        <module name="GenericWhitespace"/>
        <module name="MethodParamPad"/>

        <!-- Code quality -->
        <module name="EmptyStatement"/>
        <module name="EqualsHashCode"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="StringLiteralEquality"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="OneStatementPerLine"/>

        <!-- Modifiers -->
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>

        <!-- Blocks -->
        <module name="EmptyBlock">
            <property name="option" value="TEXT"/>
            <property name="tokens" value="LITERAL_TRY, LITERAL_FINALLY, LITERAL_IF, LITERAL_ELSE, LITERAL_SWITCH"/>
        </module>

        <!-- Design -->
        <module name="InterfaceIsType"/>

        <!-- Miscellaneous -->
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
        <!--
          Correctness checks, as distinct from the formatting ones above.

          Everything before this point is naming, spacing and imports — useful,
          and with no opinion about a switch that falls through or an equals()
          that NPEs on a null literal. That whole class of check was missing;
          SpotBugs (see pom.xml) covers the deeper cases, these cover the ones
          visible in the syntax tree and are much faster to run.
        -->
        <module name="MissingSwitchDefault"/>
        <module name="FallThrough"/>
        <module name="EqualsAvoidNull"/>
        <module name="DefaultComesLast"/>
        <module name="IllegalCatch">
            <!-- Catching Throwable or Error swallows OutOfMemoryError and
                 ThreadDeath, which are not recoverable and must not be
                 absorbed by application code. RuntimeException is fine and
                 used deliberately in the best-effort paths here. -->
            <property name="illegalClassNames" value="java.lang.Throwable, java.lang.Error"/>
        </module>

        <!--
          Size and complexity ceilings, set just above the current worst rather
          than at an ideal. A limit nobody meets today produces a wall of
          violations on day one and gets switched off; one set at today's high
          water mark stops things getting worse and can be tightened as the
          large classes are broken up. Same ratchet as the coverage floor.
        -->
        <module name="MethodLength">
            <!-- Current worst is createStripePaymentIntent at 132 lines, most
                 of which is the double-charge reasoning it carries in
                 comments. Set just above it. -->
            <property name="max" value="135"/>
        </module>
        <module name="CyclomaticComplexity">
            <!-- Current worst is 19 (inquiry scoring, a flat table of
                 conditions). Above that, and worth tightening as the two
                 offenders are broken up. -->
            <property name="max" value="20"/>
        </module>

        <!--
          NPathComplexity is deliberately NOT enabled.

          It multiplies rather than adds, so a method with ten independent
          null-guards scores 1024 while being entirely readable. This codebase
          is full of exactly that shape — defensive checks on optional fields,
          each two lines long — and the measured values (13,824 in
          LeadService; 2,940 in inquiry scoring) reflect that rather than
          anything anyone would call complex on reading it.

          Setting a ceiling above those numbers would enforce nothing;
          setting one below would flag code whose defensiveness is the point
          and push people to nest the guards instead. CyclomaticComplexity
          above measures the same methods and gives an actionable answer.
        -->

        <module name="Indentation">
            <property name="basicOffset" value="4"/>
            <property name="braceAdjustment" value="0"/>
            <property name="caseIndent" value="4"/>
            <property name="throwsIndent" value="4"/>
            <property name="lineWrappingIndentation" value="4"/>
            <property name="arrayInitIndent" value="4"/>
        </module>
    </module>
</module>
