# Copy this file to .env and fill in the values.
# Never commit .env to git.

# ─────────────────────────────────────────────────────────────────────────────
# Option A: Supabase (staging / production)
# ─────────────────────────────────────────────────────────────────────────────
# DB_URL=jdbc:postgresql://<supabase-host>:6543/<db-name>
# DB_USERNAME=<db-user>
# DB_PASSWORD=<db-password>
# FLYWAY_URL=jdbc:postgresql://<supabase-host>:5432/<db-name>
# FLYWAY_USER=<db-user>

# ─────────────────────────────────────────────────────────────────────────────
# Option B: Local Docker Compose — docker compose -f infra/docker-compose.yml up -d
# Note: port 5433 avoids conflict with system-installed PostgreSQL
# ─────────────────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5433/photograph_platform
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password>
FLYWAY_URL=jdbc:postgresql://localhost:5433/photograph_platform
FLYWAY_USER=<db-user>

# ─────────────────────────────────────────────────────────────────────────────
# Next.js frontend
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
