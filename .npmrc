# Keeps a developer-level `legacy-peer-deps=true` out of this repository.
#
# npm reads ~/.npmrc as well as this file, and an install under legacy peer
# deps resolves a different tree: @testing-library/dom (a peer of
# @testing-library/react) is dropped from package-lock.json entirely, which
# then breaks `npm ci` and the Test Web job for everyone. A project-level
# setting wins over the user one, so the lockfile stays reproducible no
# matter how a given machine is configured.
legacy-peer-deps=false
