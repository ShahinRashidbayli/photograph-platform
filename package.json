{
  "name": "photograph-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspace=apps/web",
    "test": "npm run test --workspaces --if-present",
    "prepare": "husky",
    "postinstall": "patch-package"
  },
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "apps/web/src/**/*.{ts,tsx,css,json}": "prettier --check --ignore-path apps/web/.prettierignore",
    "apps/web/src/**/*.{ts,tsx}": "bash -c 'cd apps/web && npx eslint \"$@\"' eslint",
    "apps/api/**/*.java": "bash -c \"cd apps/api && mvn -B -q checkstyle:check\""
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  }
}
