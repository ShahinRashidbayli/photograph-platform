{
  "info": {
    "name": "Photograph Platform — Sprint 1 Auth",
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "description": "Comprehensive collection for Sprint 1 exit criteria.\n\nRun order:\n1. Tenant A — Register\n2. Tenant A — Login\n3. Auth — Me\n4. Auth — Refresh\n5. Auth — Logout\n6. Tenant B — Register\n7. Tenant B — Login\n8. Cross-tenant isolation check\n9. Security edge cases",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",        "value": "http://localhost:8080",  "type": "string" },
    { "key": "tenantA_token",  "value": "", "type": "string" },
    { "key": "tenantA_refresh","value": "", "type": "string" },
    { "key": "tenantB_token",  "value": "", "type": "string" },
    { "key": "tenantB_refresh","value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01 — Tenant A · Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
              "",
              "const body = pm.response.json();",
              "pm.test('accessToken present', () => pm.expect(body.accessToken).to.be.a('string').and.not.empty);",
              "pm.test('refreshToken present', () => pm.expect(body.refreshToken).to.be.a('string').and.not.empty);",
              "pm.test('tenant subdomain correct', () => pm.expect(body.tenant.subdomain).to.eql('tenant-a'));",
              "pm.test('plan is STARTER', () => pm.expect(body.tenant.plan).to.eql('STARTER'));",
              "",
              "pm.collectionVariables.set('tenantA_token',   body.accessToken);",
              "pm.collectionVariables.set('tenantA_refresh', body.refreshToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Alice Photo\",\n  \"email\": \"alice@tenant-a.com\",\n  \"password\": \"password123\",\n  \"subdomain\": \"tenant-a\"\n}"
        }
      }
    },
    {
      "name": "01b — Tenant A · Register (duplicate subdomain → 409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 409 Conflict', () => pm.response.to.have.status(409));",
              "pm.test('error message present', () => pm.expect(pm.response.json().error).to.include('Subdomain'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Duplicate\",\n  \"email\": \"other@tenant-a.com\",\n  \"password\": \"password123\",\n  \"subdomain\": \"tenant-a\"\n}"
        }
      }
    },
    {
      "name": "01c — Register · Invalid subdomain (leading hyphen → 422)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 422 Unprocessable', () => pm.response.to.have.status(422));",
              "pm.test('error field present', () => pm.expect(pm.response.json().error).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Bad Sub\",\n  \"email\": \"bad@test.com\",\n  \"password\": \"password123\",\n  \"subdomain\": \"-invalid\"\n}"
        }
      }
    },
    {
      "name": "02 — Tenant A · Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "",
              "const body = pm.response.json();",
              "pm.test('accessToken present', () => pm.expect(body.accessToken).to.be.a('string').and.not.empty);",
              "pm.test('refreshToken present', () => pm.expect(body.refreshToken).to.be.a('string').and.not.empty);",
              "",
              "pm.collectionVariables.set('tenantA_token',   body.accessToken);",
              "pm.collectionVariables.set('tenantA_refresh', body.refreshToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alice@tenant-a.com\",\n  \"password\": \"password123\"\n}"
        }
      }
    },
    {
      "name": "02b — Login · Wrong password → 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401', () => pm.response.to.have.status(401));",
              "pm.test('Does not leak user existence', () => {",
              "  const msg = pm.response.json().error.toLowerCase();",
              "  pm.expect(msg).to.include('invalid');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alice@tenant-a.com\",\n  \"password\": \"wrongpassword\"\n}"
        }
      }
    },
    {
      "name": "02c — Login · Unknown email → 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401', () => pm.response.to.have.status(401));",
              "pm.test('Same error message (no user enumeration)', () => {",
              "  pm.expect(pm.response.json().error).to.include('Invalid');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nobody@nowhere.com\",\n  \"password\": \"password123\"\n}"
        }
      }
    },
    {
      "name": "03 — Auth · Me (with token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "",
              "const body = pm.response.json();",
              "pm.test('id present (UUID)', () => pm.expect(body.id).to.match(/^[0-9a-f-]{36}$/));",
              "pm.test('email correct', () => pm.expect(body.email).to.eql('alice@tenant-a.com'));",
              "pm.test('fullName present', () => pm.expect(body.fullName).to.be.a('string'));",
              "pm.test('role is OWNER', () => pm.expect(body.role).to.eql('OWNER'));",
              "pm.test('tenant subdomain correct', () => pm.expect(body.tenant.subdomain).to.eql('tenant-a'));",
              "pm.test('tenant plan present', () => pm.expect(body.tenant.plan).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{tenantA_token}}" }],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "03b — Auth · Me (no token → 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "03c — Auth · Me (expired/invalid token → 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer eyJhbGciOiJIUzI1NiJ9.invalid.signature" }],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "04 — Auth · Refresh token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "",
              "const body = pm.response.json();",
              "pm.test('new accessToken issued', () => pm.expect(body.accessToken).to.be.a('string').and.not.empty);",
              "pm.test('new refreshToken issued', () => pm.expect(body.refreshToken).to.be.a('string').and.not.empty);",
              "pm.test('new accessToken differs from old', () => {",
              "  pm.expect(body.accessToken).to.not.eql(pm.collectionVariables.get('tenantA_token'));",
              "});",
              "",
              "pm.collectionVariables.set('tenantA_token',   body.accessToken);",
              "pm.collectionVariables.set('tenantA_refresh', body.refreshToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/refresh",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{tenantA_refresh}}\"\n}"
        }
      }
    },
    {
      "name": "04b — Refresh · Reuse old token → 401 (rotation security)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// tenantA_refresh was already rotated in 04 — reusing it must fail",
              "// and must invalidate all sessions for the user"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401 — reuse detected', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/refresh",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{tenantA_refresh}}\"\n}"
        }
      }
    },
    {
      "name": "04c — Refresh · Re-login after invalidation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('tenantA_token',   body.accessToken);",
              "pm.collectionVariables.set('tenantA_refresh', body.refreshToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alice@tenant-a.com\",\n  \"password\": \"password123\"\n}"
        }
      }
    },
    {
      "name": "05 — Auth · Logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 204 No Content', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{tenantA_token}}" }],
        "url": "{{baseUrl}}/api/auth/logout"
      }
    },
    {
      "name": "05b — Refresh after logout → 401 (server-side invalidation)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401 — token invalidated by logout', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/refresh",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{tenantA_refresh}}\"\n}"
        }
      }
    },
    {
      "name": "05c — Me after logout → 401 (access token still valid until expiry)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Access tokens are stateless — they remain valid until expiry.",
              "// Only the refresh token is invalidated by logout.",
              "// This is expected behaviour for a JWT-based system.",
              "pm.test('Status is 200 (access token still valid)', () => pm.response.to.have.status(200));",
              "pm.test('Note: access token remains valid until 24h expiry after logout', () => pm.expect(true).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{tenantA_token}}" }],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "06 — Tenant B · Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
              "",
              "const body = pm.response.json();",
              "pm.test('tenant subdomain is tenant-b', () => pm.expect(body.tenant.subdomain).to.eql('tenant-b'));",
              "",
              "pm.collectionVariables.set('tenantB_token',   body.accessToken);",
              "pm.collectionVariables.set('tenantB_refresh', body.refreshToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Bob Studio\",\n  \"email\": \"bob@tenant-b.com\",\n  \"password\": \"password123\",\n  \"subdomain\": \"tenant-b\"\n}"
        }
      }
    },
    {
      "name": "07 — Tenant B · Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('tenantB_token',   body.accessToken);",
              "pm.collectionVariables.set('tenantB_refresh', body.refreshToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"bob@tenant-b.com\",\n  \"password\": \"password123\"\n}"
        }
      }
    },
    {
      "name": "08 — Tenant Isolation · A token → /me shows only A data",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Re-login as Tenant A to get a fresh token after logout",
              "const baseUrl = pm.collectionVariables.get('baseUrl');",
              "pm.sendRequest({",
              "  url: baseUrl + '/api/auth/login',",
              "  method: 'POST',",
              "  header: { 'Content-Type': 'application/json' },",
              "  body: { mode: 'raw', raw: JSON.stringify({ email: 'alice@tenant-a.com', password: 'password123' }) }",
              "}, (err, res) => {",
              "  if (!err) pm.collectionVariables.set('tenantA_token', res.json().accessToken);",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "",
              "const body = pm.response.json();",
              "pm.test('Returns Tenant A email', () => pm.expect(body.email).to.eql('alice@tenant-a.com'));",
              "pm.test('Returns Tenant A subdomain', () => pm.expect(body.tenant.subdomain).to.eql('tenant-a'));",
              "pm.test('Does NOT return Tenant B email', () => pm.expect(body.email).to.not.include('tenant-b'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{tenantA_token}}" }],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "08b — Tenant Isolation · B token → /me shows only B data",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "",
              "const body = pm.response.json();",
              "pm.test('Returns Tenant B email', () => pm.expect(body.email).to.eql('bob@tenant-b.com'));",
              "pm.test('Returns Tenant B subdomain', () => pm.expect(body.tenant.subdomain).to.eql('tenant-b'));",
              "pm.test('Does NOT return Tenant A email', () => pm.expect(body.email).to.not.include('tenant-a'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{tenantB_token}}" }],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "08c — Tenant Isolation · A and B user IDs are different",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Fetch both /me responses and compare IDs",
              "const baseUrl = pm.collectionVariables.get('baseUrl');",
              "const tokenA = pm.collectionVariables.get('tenantA_token');",
              "pm.sendRequest({",
              "  url: baseUrl + '/api/auth/me',",
              "  method: 'GET',",
              "  header: { 'Authorization': 'Bearer ' + tokenA }",
              "}, (err, res) => {",
              "  if (!err) pm.collectionVariables.set('tenantA_userId', res.json().id);",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Tenant B user ID differs from Tenant A', () => {",
              "  pm.expect(body.id).to.not.eql(pm.collectionVariables.get('tenantA_userId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{tenantB_token}}" }],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "09 — Security · Malformed JWT → 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer not.a.valid.jwt" }],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "09b — Security · Bearer prefix missing → 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "{{tenantA_token}}" }],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "09c — Security · Empty Authorization header → 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "" }],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "09d — Security · Register with short password → 422",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 422', () => pm.response.to.have.status(422));",
              "pm.test('error mentions password field', () => {",
              "  pm.expect(pm.response.json().error.toLowerCase()).to.include('password');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Test\",\n  \"email\": \"test@short.com\",\n  \"password\": \"short\",\n  \"subdomain\": \"shortpw\"\n}"
        }
      }
    },
    {
      "name": "09e — Security · Register with trailing hyphen subdomain → 422",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 422', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Test\",\n  \"email\": \"test@hyph.com\",\n  \"password\": \"password123\",\n  \"subdomain\": \"my-studio-\"\n}"
        }
      }
    },
    {
      "name": "10 — Schema Check · Verify tenant schema was created",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// If /me returns 200 for both tenants, Flyway migration ran successfully",
              "// (the user could not have been created if the schema init failed).",
              "pm.test('Tenant A schema exists (login succeeded)', () => {",
              "  pm.expect(pm.collectionVariables.get('tenantA_token')).to.be.a('string').and.not.empty;",
              "});",
              "pm.test('Tenant B schema exists (login succeeded)', () => {",
              "  pm.expect(pm.collectionVariables.get('tenantB_token')).to.be.a('string').and.not.empty;",
              "});",
              "pm.test('PASS — both schemas created with Flyway migration applied', () => pm.expect(true).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{tenantA_token}}" }],
        "url": "{{baseUrl}}/api/auth/me"
      }
    }
  ]
}
