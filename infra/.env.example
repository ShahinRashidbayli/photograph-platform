# Copy this file to .env and fill in the values.
# Never commit .env to git.

# ─────────────────────────────────────────────────────────────────────────────
# DB_USERNAME/FLYWAY_USER are deliberately different roles, not just
# convenience aliases: DB_USERNAME is what the app runs queries as at
# runtime, and it must be the least-privilege `fotolio_app` role created by
# V11__tenant_rls.sql — tenant isolation is enforced by Postgres Row-Level
# Security (FORCE ROW LEVEL SECURITY) against that role, so the app must
# never connect as the schema-owning role. FLYWAY_USER is that owning role,
# used only to run migrations (mvn flyway:migrate), never by the running app.
#
# Option A: Supabase (staging / production)
# ─────────────────────────────────────────────────────────────────────────────
# Port 6543 is Supavisor's transaction-mode pooler — the standard connection
# for an app backend on Supabase (direct/session connections are capped low
# even on paid plans). This is exactly the pooling mode RLS was built for:
# see TenantRoutingDataSource for why tenant isolation has to be
# transaction-scoped rather than a plain session-level SET.
# DB_URL=jdbc:postgresql://<supabase-host>:6543/<db-name>
# DB_USERNAME=fotolio_app
# DB_PASSWORD=<fotolio_app-password>   # set once via ALTER ROLE — see infra/README.md
# FLYWAY_URL=jdbc:postgresql://<supabase-host>:5432/<db-name>
# FLYWAY_USER=<owning/migration db-user>

# ─────────────────────────────────────────────────────────────────────────────
# Option B: Local Docker Compose — docker compose -f infra/docker-compose.yml up -d
# Note: port 5433 avoids conflict with system-installed PostgreSQL.
# fotolio_app is created automatically on first container start by
# infra/postgres-init/01-create-app-role.sql.
# ─────────────────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5433/centralidp
DB_USERNAME=fotolio_app
DB_PASSWORD=fotolio_app_dev_password
FLYWAY_URL=jdbc:postgresql://localhost:5433/centralidp
FLYWAY_USER=<db-user>

# ─────────────────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────────────────────
# JWT — MUST be at least 32 bytes (256 bits) for HMAC-SHA256.
# Generate a secure value with:  openssl rand -base64 64
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=<min-32-byte-secret>

# ─────────────────────────────────────────────────────────────────────────────
# CORS — comma-separated list of allowed frontend origins.
# Default (when unset): http://localhost:3000
# ─────────────────────────────────────────────────────────────────────────────
# CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ─────────────────────────────────────────────────────────────────────────────
# Email — transactional sends (magic links, verification, lead alerts).
# EMAIL_PROVIDER picks the transport: sendgrid | resend | none.
#   'none' logs and drops — safe for local dev without credentials.
# EMAIL_FROM MUST be a sender you've verified in the chosen provider
# (SendGrid Single Sender / domain auth), or every send is rejected 403.
# ─────────────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=none
EMAIL_FROM=noreply@fotolio.de
EMAIL_FROM_NAME=Fotolio
# SENDGRID_API_KEY=SG.xxxxxxxx
# RESEND_API_KEY=re_xxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# Next.js — server-side proxy target (used in next.config.mjs rewrites).
# The browser never hits this URL directly; it always goes through the proxy.
# ─────────────────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8080

# ─────────────────────────────────────────────────────────────────────────────
# Stripe — Connect (Express). Photographers onboard with Stripe-hosted KYC and
# charges are created directly on THEIR connected account; the platform's
# commission comes off each charge as an application_fee_amount.
#
# Leave STRIPE_SECRET_KEY blank to run without online payments at all: the
# Stripe client bean is then absent, the Settings screen says so, and the
# manual Überweisung path still works end to end.
#
# Enable "Connect" events on the webhook endpoint (Dashboard → Webhooks), not
# just account events — payment_intent.* for direct charges arrive stamped
# with the connected account, and account.updated is what keeps each tenant's
# charges_enabled flag honest.
# Local: stripe listen --forward-to localhost:8080/api/public/webhooks/stripe
# ─────────────────────────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# Commission in basis points (200 = 2%). Defaults match PRICING.md §4.
# STRIPE_COMMISSION_STARTER_BPS=200
# STRIPE_COMMISSION_PRO_BPS=0
# STRIPE_COMMISSION_STUDIO_BPS=0
